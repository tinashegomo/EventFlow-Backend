# ============================================================================
# EventFlow backend — environment variable reference
# ============================================================================
# IMPORTANT: Spring Boot does NOT read .env files.
#
# This file is documentation only. Use one of these two real mechanisms:
#
#   Local development
#     Copy the keys you need into backend/EventManagementSystem/local.properties
#     (git-ignored, loaded by spring.config.import=optional:file:./local.properties)
#     See local.properties.example.
#
#   Deployed / container
#     Set them as real environment variables in the host dashboard
#     (Render → Environment, Railway → Variables, Fly.io secrets, docker -e, ...).
#
# Never commit this file with real values. Only this .example version is tracked.
# ============================================================================

# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION (the "prod" profile has no fallback — the app
# refuses to start when any of these is missing)
# ---------------------------------------------------------------------------

# JDBC URL of the MySQL database.
#   local: jdbc:mysql://localhost:3306/eventflow
#   cloud: jdbc:mysql://<host>:<port>/<db>?sslMode=REQUIRED
# Do NOT add allowPublicKeyRetrieval=true — Connector/J 9 negotiates TLS itself.
DB_URL=jdbc:mysql://localhost:3306/eventflow

# MySQL user and password. Use a dedicated, least-privilege user in production
# (SELECT/INSERT/UPDATE/DELETE on the eventflow schema only). Do not use root.
DB_USER=eventflow_app
DB_PASSWORD=replace_me

# Active Spring profile. "prod" enables application-prod.properties
# (ddl-auto=validate, no stack traces, no secret defaults).
SPRING_PROFILES_ACTIVE=prod

# HMAC signing key for JWTs. Required, no default in prod.
# Generate 64 random characters, e.g.:
#   openssl rand -base64 48
#   or: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Changing this value invalidates every existing session (all users re-login).
JWT_SECRET=replace_with_64_random_characters

# Comma-separated list of browser origins allowed to call the API.
# Must be the exact deployed frontend origin(s) — scheme + host, no trailing slash.
# Example: https://eventflow.vercel.app,https://app.eventflow.example
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example

# ---------------------------------------------------------------------------
# OPTIONAL (sensible defaults exist)
# ---------------------------------------------------------------------------

# HTTP port. Spring Boot defaults to 8080; most PaaS hosts inject PORT and
# application.properties maps it via server.port=${PORT:8080}. Leave unset there.
PORT=8080

# HikariCP connection pool size (prod default: 10).
DB_POOL_SIZE=10

# Cron for the daily document-status job (default: 00:05 every day).
# Format: second minute hour day month weekday
DOCUMENT_STATUS_CRON=0 5 0 * * *

# Bootstrap ADMIN account created by DataSeeder when the database has no user
# with SEED_ADMIN_EMAIL. There is NO default password: leave SEED_ADMIN_PASSWORD
# unset and nothing is seeded at all.
#
# Set it only for the first boot of an empty database, then sign in, change the
# password in the app, and remove the variable from the host. The seeded account
# is a convenience, not a permanent credential.
SEED_ADMIN_EMAIL=tinashegomo96@gmail.com
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY (not needed in production)
# ---------------------------------------------------------------------------
# The base profile falls back to these when nothing is set. Never rely on the
# JWT fallback anywhere except your own machine.
#
#   DB_URL      defaults to jdbc:mysql://localhost:3306/eventflow
#   DB_USER     defaults to root
#   DB_PASSWORD defaults to empty
#   JWT_SECRET  has a committed development fallback — replace it everywhere shared
